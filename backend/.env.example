NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ustaad:ustaad_dev_password@localhost:5432/ustaad?schema=public
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-refresh-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AI_SERVICE_URL=http://localhost:8000
MOCK_OTP=123456

# DigiLocker Production/Sandbox Integration
DIGILOCKER_CLIENT_ID=your_digilocker_partner_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_partner_client_secret
DIGILOCKER_REDIRECT_URI=https://api.ustaad.in/api/v1/verification/digilocker/callback
DIGILOCKER_BASE_URL=https://api.digitallocker.gov.in/public/oauth2/1
DIGILOCKER_ENV=mock # mock | sandbox | production

# Indian SMS Gateway Integration (Fast2SMS / MSG91)
SMS_PROVIDER=mock # mock | console | fast2sms | msg91
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=USTAAD

# Secure Object Storage
STORAGE_PROVIDER=local # local | s3
STORAGE_PATH=private-uploads

# Firebase Cloud Messaging (FCM) Push Notifications
FCM_PROJECT_ID=ustaad-marketplace-fcm
