            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"startingPrice\": 499,\n  \"description\": \"Electrical repair\",\n  \"active\": true\n}"
        }
      }
    },
    {
      "name": "Replace provider weekly availability",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/account/availability",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"weekday\": 0,\n    \"startTime\": \"09:00\",\n    \"endTime\": \"18:00\",\n    \"enabled\": true\n  },\n  {\n    \"weekday\": 1,\n    \"startTime\": \"09:00\",\n    \"endTime\": \"18:00\",\n    \"enabled\": true\n  },\n  {\n    \"weekday\": 2,\n    \"startTime\": \"09:00\",\n    \"endTime\": \"18:00\",\n    \"enabled\": true\n  },\n  {\n    \"weekday\": 3,\n    \"startTime\": \"09:00\",\n    \"endTime\": \"18:00\",\n    \"enabled\": true\n  },\n  {\n    \"weekday\": 4,\n    \"startTime\": \"09:00\",\n    \"endTime\": \"18:00\",\n    \"enabled\": true\n  },\n  {\n    \"weekday\": 5,\n    \"startTime\": \"09:00\",\n    \"endTime\": \"18:00\",\n    \"enabled\": true\n  },\n  {\n    \"weekday\": 6,\n    \"startTime\": \"09:00\",\n    \"endTime\": \"18:00\",\n    \"enabled\": true\n  }\n]"
        }
      }
    },
