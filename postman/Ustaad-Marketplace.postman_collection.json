{
  "info": {
    "name": "Ustaad Marketplace \u2014 corrected API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sign in with the appropriate role before each action. Login stores the access/refresh tokens. Copy IDs from API responses into collection variables."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "providerId",
      "value": ""
    },
    {
      "key": "serviceId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "id",
      "value": ""
    },
    {
      "key": "photoId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "identityState",
      "value": ""
    },
    {
      "key": "phoneOtp",
      "value": ""
    },
    {
      "key": "recoveryToken",
      "value": ""
    },
    {
      "key": "fileBase64",
      "value": ""
    },
    {
      "key": "preferredAt",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(!pm.collectionVariables.get('preferredAt')){const d=new Date(Date.now()+2*86400000);d.setUTCHours(5,0,0,0);pm.collectionVariables.set('preferredAt',d.toISOString());}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Register customer",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register/customer",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Customer\",\n  \"email\": \"new@example.test\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"ChangeThis123!\"\n}"
        }
      }
    },
    {
      "name": "Register provider",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register/provider",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"New Provider\",\n  \"email\": \"provider@example.test\",\n  \"phone\": \"+919876543211\",\n  \"password\": \"ChangeThis123!\"\n}"
        }
      }
    },
    {
      "name": "Sign in",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"customer1@ustaad.local\",\n  \"password\": \"UstaadDev123!\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.response.code===200){const t=pm.response.json().tokens;pm.collectionVariables.set('accessToken',t.accessToken);pm.collectionVariables.set('refreshToken',t.refreshToken);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Rotate refresh token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/refresh",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      }
    },
    {
      "name": "Revoke refresh token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/logout",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
        }
      }
    },
    {
      "name": "Token identity",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      }
    },
    {
      "name": "Create phone challenge (development delivery)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/send-phone-otp",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+919876543210\"\n}"
        }
      }
    },
    {
      "name": "Verify phone challenge",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/verify-phone-otp",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+919876543210\",\n  \"otp\": \"{{phoneOtp}}\"\n}"
        }
      }
    },
    {
      "name": "Request password recovery",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/forgot-password",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"new@example.test\"\n}"
        }
      }
    },
    {
      "name": "Consume recovery token",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/reset-password",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{recoveryToken}}\",\n  \"password\": \"ChangedPassword123!\"\n}"
        }
      }
    },
    {
      "name": "List active categories and services",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/categories",
        "header": []
      }
    },
    {
      "name": "Rank approved nearby providers",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/search/providers?latitude=30.9&longitude=75.85&distanceKm=50",
        "header": []
      }
    },
    {
      "name": "Public provider details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/search/providers/{{id}}",
        "header": []
      }
    },
    {
      "name": "Own professional profile",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/providers/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      }
    },
    {
      "name": "Update professional profile",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/providers/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Electrician\",\n  \"description\": \"Experienced independent electrical repair professional.\",\n  \"experienceYears\": 5,\n  \"languages\": [\n    \"English\",\n    \"Hindi\"\n  ],\n  \"city\": \"Ludhiana\",\n  \"latitude\": 30.9,\n  \"longitude\": 75.85,\n  \"serviceRadiusKm\": 15\n}"
        }
      }
    },
    {
      "name": "Own account/profile/addresses",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/account/profile",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
