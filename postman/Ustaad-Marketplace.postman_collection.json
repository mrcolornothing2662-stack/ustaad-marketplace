        }
      }
    },
    {
      "name": "Own provider reviews",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/account/reviews",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ]
      }
    },
